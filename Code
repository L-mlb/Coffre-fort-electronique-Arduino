// PROTOTYPES
// Déclarations des fonctions utilisées dans le programme pour que le compilateur les connaisse.
bool questionSecurite();        // Etape 1 : Demande de réponses par le moniteur série.
bool sequenceBoutons();        // Etape 2 : Vérification du code secret entré par les boutons.
bool attendreScanRetinien();   // Etape 3 : Simulation de scan rétinien par le moniteur série.
bool verifierEmpreinteDigitale(); // Etape 4 : Simulation de vérification d'empreinte.
void eteindreToutesLesLeds();  // Éteint toutes les LEDs (Rouges et Verte).
void allumerLed(int pin, bool on); // Fonction générique pour allumer/éteindre une LED.
void stopSystem();             // Bloque le système en cas d'échec.
void clignoterLedVerte(int fois, int duree); // Fait clignoter la LED verte pour indiquer la réussite d'une étape.
int lireBouton();              // Lit l'état des boutons et gère l'anti-rebond/la détection de pression.
void genererCode();            // Génère le code aléatoire de l'Étape 2.
bool verifierBoutonSimple(int bouton); // Vérifie si le bouton pressé correspond à la séquence attendue.

// BROCHES
// Définition des broches numériques utilisées pour les LEDs et les Boutons.
const int ledRouge1 = 8;
const int ledRouge2 = 9;
const int ledRouge3 = 10;
const int ledRouge4 = 11;
const int ledVerte  = 12; // LED Verte, signal d'accès réussi ou d'étape validée.

const int bouton1 = 2;
const int bouton2 = 3;
const int bouton3 = 4;
const int bouton4 = 5;

// VARIABLES GLOBALES
int codeSecret[4];          // Tableau pour stocker la séquence du code secret (4 chiffres).
int position = 0;           // Compteur de la position actuelle dans le code secret (0 à 3).
bool boutonPresse = false;  // Variable pour la gestion de l'anti-rebond des boutons (pour ne compter qu'une seule pression).

const bool LED_ACTIVE_HIGH = true;  // Détermine si HIGH allume la LED (True) ou LOW (False).

// Indicateurs de statut de chaque étape (initialement à false).
bool etape1_OK = false;
bool etape2_OK = false;
bool etape3_OK = false;
bool etape4_OK = false;

const int MAX_ATTEMPTS_CODE = 2; // Nombre maximum d'erreurs autorisées pour l'Étape 2 (Code Secret).
const int MAX_ATTEMPTS_AUTRES = 1; // Nombre maximum d'erreurs pour les autres étapes (ici, une seule tentative).

 
// SETUP
void setup() {
  Serial.begin(9600); // Initialisation de la communication série à 9600 bauds.
  Serial.println(" SYSTEME DE SECURITE ACTIVE ");

  // Configuration des broches des LEDs en mode SORTIE (OUTPUT).
  pinMode(ledRouge1, OUTPUT);
  pinMode(ledRouge2, OUTPUT);
  pinMode(ledRouge3, OUTPUT);
  pinMode(ledRouge4, OUTPUT);
  pinMode(ledVerte, OUTPUT);

  // Configuration des broches des boutons en mode ENTREE avec résistance PULLUP interne.
  // Un bouton pressé mettra la broche à LOW.
  pinMode(bouton1, INPUT_PULLUP);
  pinMode(bouton2, INPUT_PULLUP);
  pinMode(bouton3, INPUT_PULLUP);
  pinMode(bouton4, INPUT_PULLUP);

  eteindreToutesLesLeds(); // S'assure que toutes les LEDs sont éteintes au démarrage.
  randomSeed(analogRead(A0)); // Initialise le générateur de nombres aléatoires avec une source analogique (pour le code secret).

  // 		Début des étapes de sécurité 

  // ETAPE 1(Questions de sécurité):
  if (!questionSecurite()) stopSystem(); // Si l'étape échoue, appel à stopSystem.
  Serial.println("ETAPE 1 REUSSIE");
  clignoterLedVerte(2, 200); // Signal de réussite.

  // ETAPE 2(Code secret par boutons):
  if (!sequenceBoutons()) stopSystem();
  Serial.println("ETAPE 2 REUSSIE");
  clignoterLedVerte(2, 200);

  // ETAPE 3(Scan rétinien):
  if (!attendreScanRetinien()) stopSystem();
  Serial.println("ETAPE 3 REUSSIE");
  clignoterLedVerte(2, 200);

  // ETAPE 4(Empreinte digitale):
  if (!verifierEmpreinteDigitale()) stopSystem();
  Serial.println("ETAPE 4 REUSSIE");
  clignoterLedVerte(2, 200);

  // Séquence de réussite finale
  allumerLed(ledVerte, true);
  Serial.println("ACCES AUTORISE - SEQUENCE TERMINEE");
}

void loop() {} // La fonction loop est vide car toute la logique de sécurité est exécutée dans setup().


// FONCTIONS UTILES

// Fonction pour contrôler l'état d'une LED en tenant compte de la configuration ACTIVE_HIGH/LOW.
void allumerLed(int pin, bool on) {
  if (LED_ACTIVE_HIGH) digitalWrite(pin, on ? HIGH : LOW);
  else digitalWrite(pin, on ? LOW : HIGH);
}

// Fonction pour éteindre toutes les LEDs.
void eteindreToutesLesLeds() {
  allumerLed(ledRouge1, false);
  allumerLed(ledRouge2, false);
  allumerLed(ledRouge3, false);
  allumerLed(ledRouge4, false);
  allumerLed(ledVerte, false);
}

// Fonction pour bloquer le système en cas d'échec.
void stopSystem() {
  // Allume toutes les LEDs Rouges pour signaler le blocage.
  allumerLed(ledRouge1, true);
  allumerLed(ledRouge2, true);
  allumerLed(ledRouge3, true);
  allumerLed(ledRouge4, true);
  allumerLed(ledVerte, false);
  Serial.println("SYSTEME BLOQUE : une authentification a echoue. ARRET.");
  while(true){} // Boucle infinie, bloque le programme (l'Arduino ne fait plus rien).
}

// Fonction pour faire clignoter la LED verte.
void clignoterLedVerte(int fois, int duree) {
  for(int i=0; i<fois; i++){
    allumerLed(ledVerte, true);
    delay(duree);
    allumerLed(ledVerte, false);
    delay(duree);
  }
}


// ETAPE 1 : QUESTIONS DE SECURITE
// IMPORTANT : pour les réponses, il faut les écrire dans le terminal de la même façon
// dont elles seront affichées (1e lettre en MAJ)!!!
// SINON, écrire le n° de la réponse !!!

bool questionSecurite() {
  Serial.println("\n[ETAPE 1] QUESTIONS DE SECURITE :");

  // Question 1 : France
  Serial.println("Question 1 : Quelle est la capitale de la France ?");
  Serial.println("1) Moscou\n2) Paris\n3) Berlin\n4) Tokyo\n5) Kiev");
  Serial.print("Tapez votre réponse : ");

  while (Serial.available() == 0) {} // Attend que l'utilisateur tape quelque chose dans le moniteur série.
  String reponse1 = Serial.readStringUntil('\n'); // Lit l'entrée jusqu'au retour à la ligne.
  reponse1.trim(); // Supprime les espaces inutiles.

  // Vérifie si la réponse est "Paris" ou "2" (insensible à la casse pour "Paris").
  if (!(reponse1.equalsIgnoreCase("Paris") || reponse1.equals("2"))) {
    Serial.println("Mauvaise réponse à la question 1. Tentative unique dépassée.");
    return false;
  }

  Serial.println("Bonne réponse à la question 1 !");

  // Question 2 : Ukraine
  Serial.println("\nQuestion 2 : Quelle est la capitale de l'Ukraine ?");
  Serial.println("1) Varsovie\n2) Prague\n3) Kiev\n4) Budapest\n5) Bucarest");
  Serial.print("Tapez votre réponse : ");

  while (Serial.available() == 0) {} // Attend la deuxième réponse.
  String reponse2 = Serial.readStringUntil('\n');
  reponse2.trim();

  // Vérifie la deuxième réponse.
  if (reponse2.equalsIgnoreCase("Kiev") || reponse2.equals("3")) {
    Serial.println("Bonne réponse à la question 2 !");
    etape1_OK = true;
    return true; // Étape réussie.
  } else {
    Serial.println("Mauvaise réponse à la question 2. Tentative unique dépassée.");
    return false; // Étape échouée.
  }
}


// ETAPE 2 : CODE SECRET

bool sequenceBoutons() {
  Serial.println("\n[ETAPE 2] CODE SECRET :");
  genererCode(); // Génère le nouveau code secret.
  position = 0;
  eteindreToutesLesLeds();

  int wrongCount = 0; // Compteur d'erreurs pour cette étape.

  // Boucle tant que le code n'est pas entièrement entré (position < 4) et que le max d'erreurs n'est pas atteint.
  while (position < 4 && wrongCount < MAX_ATTEMPTS_CODE) {
    int bouton = lireBouton(); // Lit si un bouton a été pressé (retourne 1, 2, 3, 4 ou 0).
    
    if (bouton != 0) { // Si un bouton a été pressé
      
      if (verifierBoutonSimple(bouton)) { // Vérifie si le bouton correspond à la position actuelle.
        
        // Si la vérification est réussie et que la position atteint 4 (code complet).
        if (position == 4) {
          etape2_OK = true;
          allumerLed(ledVerte, true);
          return true; // Étape réussie.
        }
      } else {
        // Erreur de séquence
        wrongCount++;
        Serial.println("Erreur sur ETAPE 2 !");
        position = 0; // Réinitialise la séquence
        eteindreToutesLesLeds();
        
        // Vérifie si le max d'erreurs est atteint.
        if (wrongCount >= MAX_ATTEMPTS_CODE) {
          Serial.println("Nombre max d'erreurs depasse pour ETAPE 2.");
          return false; // Étape échouée.
        }
      }
    }
  }
  // Si on sort de la boucle sans succès (p.ex. par manque de saisie), on échoue.
  return false;
}

// Fonction pour lire l'état des boutons.
int lireBouton() {
  // Lit les boutons. S'il est à LOW (pressé) ET qu'aucun bouton n'était déjà en cours de pression (!boutonPresse),
  // on marque le bouton comme pressé, et on retourne son identifiant.
  if (digitalRead(bouton1) == LOW && !boutonPresse){ boutonPresse=true; return 1; }
  if (digitalRead(bouton2) == LOW && !boutonPresse){ boutonPresse=true; return 2; }
  if (digitalRead(bouton3) == LOW && !boutonPresse){ boutonPresse=true; return 3; }
  if (digitalRead(bouton4) == LOW && !boutonPresse){ boutonPresse=true; return 4; }
  
  // Si TOUS les boutons sont relâchés (HIGH), on réinitialise le drapeau boutonPresse.
  // C'est la logique d'anti-rebond basique qui permet de détecter la prochaine pression.
  if (digitalRead(bouton1)==HIGH && digitalRead(bouton2)==HIGH && digitalRead(bouton3)==HIGH && digitalRead(bouton4)==HIGH){
    boutonPresse=false;
  }
  return 0; // Rien de nouveau n'est pressé.
}

// Génère un nouveau code secret aléatoire.
void genererCode() {
  position = 0;
  Serial.print("Code secret (affiche pour l'utilisateur) : ");
  for (int i=0;i<4;i++){
    codeSecret[i]=random(1,5); // Génère un nombre aléatoire entre 1 et 4 (inclus).
    Serial.print(codeSecret[i]);
    if(i<3) Serial.print("-");
  }
  Serial.println("\nAppuie sur les boutons dans cet ordre !");
}

// Vérifie si le bouton pressé correspond au chiffre attendu dans la séquence.
bool verifierBoutonSimple(int bouton){
  if (bouton==codeSecret[position]){ // Si le bouton est correct
    // Allume la LED rouge correspondante à la position actuelle.
    if(position==0) allumerLed(ledRouge1,true);
    if(position==1) allumerLed(ledRouge2,true);
    if(position==2) allumerLed(ledRouge3,true);
    if(position==3) allumerLed(ledRouge4,true);
    position++; // Passe à la position suivante du code.
    return true;
  } else {
    // Si le bouton est incorrect
    position=0; // Réinitialise la séquence complète.
    eteindreToutesLesLeds(); // Éteint les LEDs rouges déjà allumées.
    return false;
  }
}


// ETAPE 3 : SCAN RETINIEN (Simulé)
// Le scan rétinien n'est pas possible donc il faut juste écrire la réponse attendue
// --> "oeil droit"
bool attendreScanRetinien() {
  Serial.println("\n[ETAPE 3] SCAN RETINIEN :");
  // Boucle de tentative (ici limitée à une seule dans le setup)
  while(!etape3_OK){
    Serial.print("Placez votre oeil et tapez la reponse correcte : ");
    while (Serial.available() == 0) {}
    String entree = Serial.readStringUntil('\n'); entree.trim();
    
    if (entree.equalsIgnoreCase("oeil droit")){ // Condition de succès (simulation).
      etape3_OK=true;
      return true;
    } else {
      Serial.println("Erreur sur ETAPE 3. Tentative unique depassee.");
      return false; // Échoue après une seule tentative.
    }
  }
  return false; // Ne devrait pas être atteint dans ce setup.
}


